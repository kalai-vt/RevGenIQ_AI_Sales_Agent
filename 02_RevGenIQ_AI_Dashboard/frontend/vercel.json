{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://revgeniq-ai-backend.vercel.app/api/:path*" },
    { "source": "/widget/v1/:path*", "destination": "https://revgeniq-ai-backend.vercel.app/widget/v1/:path*" },
    { "source": "/uploads/:path*", "destination": "https://revgeniq-ai-backend.vercel.app/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
